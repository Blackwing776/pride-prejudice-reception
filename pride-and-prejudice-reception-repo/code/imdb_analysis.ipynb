   "source": [
    "from collections import Counter\n",
    "import math\n",
    "import re\n",
    "import csv\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "OUTPUT_DIR = \"./output\"\n",
    "Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# 1. 데이터 로드\n",
    "imdb_reviews = []\n",
    "with open(\"./data/PnP_Film_IMDb.csv\", encoding=\"utf-8-sig\") as f:\n",
    "    reader = csv.reader(f)\n",
    "    for row in reader:\n",
    "        if row and row[0].strip():\n",
    "            imdb_reviews.append(row[0].strip())\n",
    "\n",
    "print(f\"IMDb 리뷰 수: {len(imdb_reviews):,}개\")\n",
    "\n",
    "# 2. 토큰화\n",
    "STOPWORDS_EN = {\n",
    "    \"the\",\"a\",\"an\",\"and\",\"or\",\"but\",\"in\",\"on\",\"at\",\"to\",\"for\",\"of\",\"with\",\n",
    "    \"is\",\"was\",\"are\",\"were\",\"it\",\"this\",\"that\",\"i\",\"he\",\"she\",\"they\",\"his\",\n",
    "    \"her\",\"their\",\"my\",\"you\",\"we\",\"be\",\"as\",\"so\",\"if\",\"by\",\"from\",\"not\",\n",
    "    \"have\",\"has\",\"had\",\"do\",\"did\",\"would\",\"could\",\"should\",\"will\",\"just\",\n",
    "    \"also\",\"very\",\"more\",\"than\",\"then\",\"there\",\"which\",\"who\",\"what\",\"how\",\n",
    "    \"all\",\"one\",\"its\",\"about\",\"out\",\"up\",\"when\",\"no\",\"into\",\"been\",\"they\"\n",
    "}\n",
    "\n",
    "def tokenize_en(text):\n",
    "    tokens = re.findall(r\"\\b[a-z]+\\b\", text.lower())\n",
    "    return [t for t in tokens if t not in STOPWORDS_EN and len(t) > 2]\n",
    "\n",
    "imdb_tokenized = [tokenize_en(r) for r in imdb_reviews]\n",
    "imdb_raw = [r.lower() for r in imdb_reviews]\n",
    "\n",
    "all_en_tokens = [t for toks in imdb_tokenized for t in toks]\n",
    "print(f\"전체 토큰 수: {len(all_en_tokens):,}개\")\n",
    "print(f\"'father' 등장: {all_en_tokens.count('father'):,}회\")\n",
    "print(f\"'dad/daddy' 등장: {all_en_tokens.count('dad') + all_en_tokens.count('daddy'):,}회\")\n",
    "print(f\"'bennet/bennett' 등장: {sum(1 for r in imdb_raw if 'bennet' in r or 'bennett' in r):,}회\")\n",
    "\n",
    "# 3. Collocation 함수\n",
    "def get_collocates_en(reviews_tokenized, reviews_raw, target_set, is_phrase=False, window=5, min_freq=3):\n",
    "    all_tokens = [t for toks in reviews_tokenized for t in toks]\n",
    "    N = len(all_tokens)\n",
    "    freq_all = Counter(all_tokens)\n",
    "    cooc = Counter()\n",
    "    target_total = 0\n",
    "\n",
    "    for tokens, raw in zip(reviews_tokenized, reviews_raw):\n",
    "        if is_phrase:\n",
    "            # mr bennet을 하나의 토큰처럼 처리\n",
    "            for phrase in target_set:\n",
    "                words = phrase.replace(\".\", \"\").split()\n",
    "                for idx in range(len(tokens) - len(words) + 1):\n",
    "                    if tokens[idx:idx+len(words)] == words:\n",
    "                        target_total += 1\n",
    "                        start = max(0, idx - window)\n",
    "                        end = min(len(tokens), idx + len(words) + window)\n",
    "                        context = tokens[start:idx] + tokens[idx+len(words):end]\n",
    "                        for token in context:\n",
    "                            cooc[token] += 1\n",
    "        else:\n",
    "            for idx, token in enumerate(tokens):\n",
    "                if token in target_set:\n",
    "                    target_total += 1\n",
    "                    start = max(0, idx - window)\n",
    "                    end = min(len(tokens), idx + window + 1)\n",
    "                    for j in range(start, end):\n",
    "                        if j != idx:\n",
    "                            cooc[tokens[j]] += 1\n",
    "    # 나머지 동일\n",
    "\n",
    "    rows = []\n",
    "    for collocate, O11 in cooc.items():\n",
    "        if O11 < min_freq or collocate in target_set:\n",
    "            continue\n",
    "        f_t = target_total\n",
    "        f_c = freq_all[collocate]\n",
    "        E11 = max((f_t * f_c) / N, 1e-9)\n",
    "        mi = math.log2(O11 / E11)\n",
    "        t_score = (O11 - E11) / math.sqrt(O11)\n",
    "\n",
    "        def sll(o, e): return o * math.log(o/e) if o > 0 and e > 0 else 0\n",
    "        E12 = max((f_t * (N - f_c)) / N, 1e-9)\n",
    "        E21 = max(((N - f_t) * f_c) / N, 1e-9)\n",
    "        E22 = max(((N - f_t) * (N - f_c)) / N, 1e-9)\n",
    "        O12 = f_t - O11\n",
    "        O21 = f_c - O11\n",
    "        O22 = N - O11 - O12 - O21\n",
    "        ll = 2*(sll(O11,E11)+sll(O12,E12)+sll(O21,E21)+sll(O22,E22))\n",
    "\n",
    "        rows.append({\"collocate\": collocate, \"빈도\": O11,\n",
    "                     \"MI\": round(mi,4), \"T_score\": round(t_score,4),\n",
    "                     \"log_likelihood\": round(ll,4)})\n",
    "\n",
    "    if not rows:\n",
    "        print(f\"  ⚠️ 공기어 없음 (target_total={target_total})\")\n",
    "        return pd.DataFrame(columns=[\"collocate\",\"빈도\",\"MI\",\"T_score\",\"log_likelihood\"])\n",
    "\n",
    "    return pd.DataFrame(rows).sort_values(\"log_likelihood\", ascending=False)\n",
    "\n",
    "# 4. 분석 실행\n",
    "en_targets = {\n",
    "    \"father\": ({\"father\"}, False),\n",
    "    \"dad_daddy\": ({\"dad\", \"daddy\"}, False),\n",
    "    \"mr_bennet\": ({\"mr bennet\", \"mr. bennet\", \"mr bennett\", \"mr. bennett\", \"bennet\", \"bennett\"}, True),\n",
    "}\n",
    "\n",
    "en_dfs = {}\n",
    "for name, (target_set, is_phrase) in en_targets.items():\n",
    "    df = get_collocates_en(imdb_tokenized, imdb_raw, target_set, is_phrase)\n",
    "    en_dfs[name] = df\n",
    "    df.to_csv(f\"{OUTPUT_DIR}/collocation_en_{name}.csv\", index=False, encoding=\"utf-8-sig\")\n",
    "    print(f\"\\n[{name}] 공기어 {len(df)}개\")\n",
    "    if len(df) > 0:\n",
    "        print(df[[\"collocate\",\"빈도\",\"MI\",\"T_score\",\"log_likelihood\"]].head(15).to_string(index=False))\n",
    "    print(\"-\"*50)"
   ]
  }
